                "${workspaceFolder}/components/infrastructure_gpio/include",
                "${workspaceFolder}/components/application/include",
                "${workspaceFolder}/components/main"
            ],

            "browse": {
                "path": [
                    "${workspaceFolder}/components",
                    "${workspaceFolder}/main",
                    "${workspaceFolder}/startup"
                ]
            }
        }
    ]
