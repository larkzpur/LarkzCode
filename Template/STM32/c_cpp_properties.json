            "compilerPath": "C:/Program Files (x86)/Arm GNU Toolchain/12.2 mpacbti-rel1/bin/arm-none-eabi-g++.exe",

            "compilerArgs": [
                "-mcpu=cortex-m4",
                "-mthumb",
                "-mfpu=fpv4-sp-d16",
